# ============================================================================
# nongyu-backend-plus 环境变量清单
# ============================================================================
# 复制为 .env 后按需修改；.env 已在 .gitignore 中，禁止提交真实值。
#
# 本文件与 internal/config/config.go 的 Load() 一一对应，覆盖它读取的**全部**
# 环境变量。新增配置项时请同步更新这里——否则部署时会漏配且难以发现。
# （internal/config/env_example_test.go 会强制校验两者一致，漏写即测试失败。）
#
# 标注约定：
#   [必填-prod]  生产/预发布环境缺失即拒绝启动
#   [必填]       缺失会导致该能力不可用（但不阻止启动）
#   [可选]       有安全默认值，不配也能跑
#
# 关于「不配也能起」：骨架期设计目标是无 .env 时 `go run ./cmd/server` 能起一个
# 只有 /healthz 与公开读端点的服务。但这种「空壳启动」在生产是危险的——
# 下文每个 [必填] 项都会导致对应能力静默不可用，启动日志里有 WARN 提示。
# ============================================================================


# ---------------------------------------------------------------------------
# 1. 基础
# ---------------------------------------------------------------------------

# HTTP 监听地址。[可选] 默认 :8080
ADDR=:8080

# 运行环境：dev / staging / prod。[可选] 默认 dev
# staging 与 prod 会触发文末「生产强校验」节的逐条检查。
APP_ENV=dev

# 优雅关停等待在途请求的最长秒数，必须为正整数。[可选] 默认 10
# 关停时会先等 HTTP 请求结束，再 flush 通知/埋点缓冲，最后关数据库池。
SHUTDOWN_TIMEOUT_SEC=10


# ---------------------------------------------------------------------------
# 2. 入站 HTTP 超时与限流
# ---------------------------------------------------------------------------

# 读 / 写 / 空闲超时（秒）。[可选] 默认 15 / 30 / 90
HTTP_READ_TIMEOUT_SEC=15
HTTP_WRITE_TIMEOUT_SEC=30
HTTP_IDLE_TIMEOUT_SEC=90

# 每用户每分钟允许的请求数。[可选] 默认 60；prod 必须为正整数
# 内部信发送也复用这一个限流器（口径与其他端点一致）。
RATE_LIMIT_PER_MINUTE=60


# ---------------------------------------------------------------------------
# 3. 认证与请求签名（安全不变量，见 ADR-0001 / ADR-0003）
# ---------------------------------------------------------------------------

# 认证令牌 HMAC 签名密钥。[必填-prod]
# 为空时**不挂认证中间件**——所有业务端点无身份校验。
# dev 下为空需显式开启 ALLOW_INSECURE_DEV，否则拒绝装配。
AUTH_KEY=

# dev 下 AUTH_KEY 为空时，必须显式开启此项才允许「无认证」装配。[可选] 默认 false
# 不设置 APP_ENV 与 AUTH_KEY 直接 go run 时，为兼容骨架健康检查会自动视为开启。
ALLOW_INSECURE_DEV=false

# 票据加密主密钥（tgt 保管、身份证号加密都由它派生）。[必填-prod]
# 未配置时回落到开发占位值 dev-only-placeholder-key-change-me。
# prod 下必须是**非占位值**且 ≥ 32 字节，否则拒绝启动。
TICKET_KEY=

# Android 请求签名密钥。[必填-prod]
# 格式：kid:base64url[,kid2:base64url]，无 padding，解码后 ≥ 32 字节。
# 未配置时 dev 不校验（仅本地）；prod 拒绝启动，staging 在 app.New 拒绝启动。
# 下面这把与 nongyu-app-plus 默认构建内置的是同一把开发密钥，不是生产秘密（APK 里拿得到）。
# 轮换：新 kid 与旧 kid 同时留在这里，直到旧包下线再删旧 kid。
# APP_SIGNING_KEYS=dev:bm9uZ3l1LWRldi1hcHAtc2lnbi1rZXktdjEtMzJiISE
APP_SIGNING_KEYS=

# 免密换票加速路径（#17）。[可选] 默认 false
# 门户 appid 免密能力未验证，真实手工验收通过前不得置 true。
ACCEL_ENABLED=false


# ---------------------------------------------------------------------------
# 4. 出站请求闸口（访问学校系统的唯一出口）
# ---------------------------------------------------------------------------

# 是否启用出站闸口强制：白名单 / 不跟随 302 / 超时 / 响应体上限。
# [可选] 默认 true；**prod 不得关闭**（关闭即拒绝启动）。
# 注意：这一个开关同时决定「是否强制策略」与「是否走真实网络」。
HTTP_ENFORCE=true

# 出站目标白名单，逗号分隔的主机名。[可选] 默认空（= 不限制）
# 例：HTTP_ALLOWLIST=jiaowu.example.edu.cn,xsgz.example.edu.cn
HTTP_ALLOWLIST=

# 出站请求单次超时（秒）。[可选] 默认 5，必须为正整数
HTTP_TIMEOUT_SEC=5


# ---------------------------------------------------------------------------
# 5. Postgres（业务数据 + 审计流水 + 身份域）
# ---------------------------------------------------------------------------

# 连接串。[必填] 为空时：审计只写 stdout、身份域完全不可用、
# 业务四域全部回落内存实现（重启即丢）。
# 启动时会自动执行 migrations/*.sql（幂等）。
# 例：DATABASE_URL=postgres://user:pass@127.0.0.1:5432/nongyu?sslmode=disable
DATABASE_URL=


# ---------------------------------------------------------------------------
# 6. Redis（票据外置持久 + 缓存 + 会话副本）
# ---------------------------------------------------------------------------

# 地址，形如 127.0.0.1:6379。[必填-prod]
# 为空时：票据回落进程内存（重启即丢、无法多实例）、缓存层不启用、
# 会话不加速（仍走 PG，正确性不受影响）。
REDIS_ADDR=
REDIS_PASSWORD=
# 逻辑库编号。[可选] 默认 0
REDIS_DB=0
# 键名前缀，便于多环境共用一个 Redis 时隔离。[可选] 默认 nongyu:
REDIS_PREFIX=nongyu:

# --- 缓存行为（只在配了 REDIS_ADDR 时生效）---

# 正常值默认存活秒数。[可选] 默认 300
CACHE_DEFAULT_TTL_SEC=300
# TTL 抖动比例（0~1），防雪崩。[可选] 默认 0.2
CACHE_JITTER_RATIO=0.2
# 「查无此物」空值缓存秒数，防穿透。[可选] 默认 15
CACHE_NOT_FOUND_TTL_SEC=15
# 降级恢复后回灌内存数据到 Redis 的每秒限速，防打垮。[可选] 默认 100
CACHE_FLUSH_RATE_PER_SEC=100
# Redis 连续失败多少次后打开熔断。[可选] 默认 5
CACHE_BREAKER_THRESHOLD=5
# 熔断冷却秒数，期满转半开探测。[可选] 默认 5
CACHE_BREAKER_COOLDOWN_SEC=5


# ---------------------------------------------------------------------------
# 7. MinIO 对象存储（帖子图片附件）
# ---------------------------------------------------------------------------

# Endpoint，形如 127.0.0.1:9000——**不带 scheme**（minio-go 的约定，
# 带 http:// 会被当成主机名解析失败）。
# [必填] 为空时附件写进进程内存，重启即丢，仅限本地开发。
# 配置后会做桶存在性检查：**桶不存在则拒绝启动**（不自动建桶，
# 避免「配置写错桶名」变成「悄悄多了一个空桶」）。
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# 桶名。[可选] 默认 nongyu
MINIO_BUCKET=nongyu
# 是否走 https。[可选] 默认 false
MINIO_USE_SSL=false


# ---------------------------------------------------------------------------
# 8. SMTP（登录验证码等邮件）
# ---------------------------------------------------------------------------

# [必填] 为空时回落到「把邮件内容打进日志」的实现（仅本地开发）。
SMTP_HOST=
# [可选] 默认 587
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# 发件人地址，形如 noreply@example.com。
SMTP_FROM=
# 跳过 TLS 证书校验。[可选] 默认 false
# 仅用于自签证书的内网邮件服务器；公网环境开启此项会失去对中间人的防护。
SMTP_INSECURE=false


# ============================================================================
# 生产强校验（APP_ENV=staging 或 prod 时逐条生效，任一不满足即拒绝启动）
# ============================================================================
# 1. TICKET_KEY 必须显式配置、非开发占位值、且 ≥ 32 字节
# 2. HTTP_ENFORCE 不得为 false
# 3. AUTH_KEY 必须非空
# 4. RATE_LIMIT_PER_MINUTE 必须为正整数
# 5. REDIS_ADDR 必须非空（票据需外置持久，内存实现重启即丢）
# 6. APP_SIGNING_KEYS 必须非空
# 7. （app.New 层）staging/prod 下 AUTH_KEY 为空且未开 ALLOW_INSECURE_DEV 也拒绝
#
# 这些是 ADR-0001 的安全不变量，不允许用环境变量悄悄弱化。
# ============================================================================
