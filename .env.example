# 复制为 .env 后按需修改；.env 已在 .gitignore 中，禁止提交真实值。

# HTTP 监听地址
ADDR=:8080

# 运行环境：dev / staging / prod
# staging 与 prod 都必须配置 AUTH_KEY，否则服务拒绝启动（认证中间件不会挂载）。
APP_ENV=dev

# 认证令牌 HMAC 签名密钥。prod/staging 必填；dev 可留空但需看下一项。
AUTH_KEY=

# dev 下 AUTH_KEY 为空时，必须显式开启此项才允许「无认证」装配（仅限本地开发）。
# 不设置 APP_ENV 与 AUTH_KEY 直接 go run 时，为兼容骨架健康检查会自动视为开启。
ALLOW_INSECURE_DEV=false

# 优雅关停等待在途请求的最长秒数（正整数）
SHUTDOWN_TIMEOUT_SEC=10
