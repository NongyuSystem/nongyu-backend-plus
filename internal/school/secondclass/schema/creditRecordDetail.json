{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "creditRecordDetail payload",
  "type": "object",
  "required": ["payload", "schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "success": { "type": "boolean" },
    "fetchedAt": { "type": "string" },
    "payload": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["firstTypeName", "totalScore", "content"],
        "properties": {
          "firstTypeName": { "type": "string" },
          "firstTypeId": { "type": "string" },
          "totalScore": { "type": "number" },
          "_totalItemsInGroup": { "type": "integer" },
          "content": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "required": ["fistActTypeId"],
              "properties": {
                "creditRecordId": { "type": "string" },
                "eventName": { "type": "string" },
                "validCredit": { "type": "number" },
                "display": { "type": "integer" },
                "fistActTypeId": { "type": "string" },
                "firstActTypeName": { "type": "string" },
                "grantTime": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
