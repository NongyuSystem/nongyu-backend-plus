{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "userSearchList payload（按名称搜用户）",
  "type": "object",
  "required": [
    "payload",
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "success": {
      "type": "boolean"
    },
    "fetchedAt": {
      "type": "string"
    },
    "payload": {
      "oneOf": [
        {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
