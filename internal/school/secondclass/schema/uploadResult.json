{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "uploadResult payload（上传结果）",
  "type": "object",
  "required": [
    "payload",
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "success": {
      "type": "boolean"
    },
    "fetchedAt": {
      "type": "string"
    },
    "payload": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "uuid": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
