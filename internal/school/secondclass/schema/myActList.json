{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "myActList payload（我参与的活动）",
  "type": "object",
  "required": [
    "payload",
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "success": {
      "type": "boolean"
    },
    "fetchedAt": {
      "type": "string"
    },
    "payload": {
      "oneOf": [
        {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "addr": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "logo": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "startTime": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "endTime": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "statusName": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "typeName": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "period": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "signFlag": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "signUpTime": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "signOutTime": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
