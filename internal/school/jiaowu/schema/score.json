{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "score payload",
  "type": "object",
  "required": ["payload", "schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "success": { "type": "boolean" },
    "fetchedAt": { "type": "string" },
    "payload": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["courseName", "score"],
        "properties": {
          "courseName": { "type": "string", "minLength": 1 },
          "score": { "type": "string", "minLength": 1 },
          "credit": { "type": "string" },
          "gradePoint": { "type": "string" },
          "term": { "type": "string" },
          "courseType": { "type": "string" },
          "source": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
