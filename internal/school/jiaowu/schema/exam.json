{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "exam payload",
  "type": "object",
  "required": ["payload", "schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "success": { "type": "boolean" },
    "fetchedAt": { "type": "string" },
    "payload": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "anyOf": [{ "required": ["courseName"] }, { "required": ["examTime"] }],
        "properties": {
          "courseName": { "type": "string" },
          "examTime": { "type": "string" },
          "examRoom": { "type": "string" },
          "seatNumber": { "type": "string" },
          "assessmentMethod": { "type": "string" }
        }
      }
    }
  }
}
